# OS / editor
.DS_Store

# Generated database
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-wal
/db/*.sqlite3-shm

# Generated exports + viewer data
/exports/reports/*.json
/web/data.js

# Upload inbox (PDFs dropped via the web UI)
/inbox/*.pdf

# Personal sample data — real IDEXX reports and their parsed parity fixtures
# (contain owner names, clinic, values). Kept locally to run tests; never
# committed, so the repo can be made public without exposing them.
/samples/*.pdf
/test/fixtures/*.json
# ...but synthetic demo fixtures (parity oracle for CI) ARE committed.
!/test/fixtures/demo-*.json
# ...but the synthetic, fictional demo reports (generated by
# scripts/make_sample_pdfs.rb) ARE committed so the project ships shareable data.
!/samples/demo-*.pdf

# Ruby
/.bundle/
/vendor/bundle/

# Node (JS tooling / browser build)
node_modules/
# Comprehensive Ruby parser tests over the private corpus (real PDFs) — local only
/test/test_parser_local.rb
